{
  "name": "mathe-jahrmarkt",
  "private": true,
  "version": "0.8.0",
  "description": "Mathe-Jahrmarkt – Fit für Klasse 5. Spielerische Vorbereitung auf den Übergang zur weiterführenden Schule.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "store-check": "node scripts/store-check.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run check && npm test && npm run build && npm run store-check",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.0",
    "@fontsource/nunito": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "playwright-core": "^1.56.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
